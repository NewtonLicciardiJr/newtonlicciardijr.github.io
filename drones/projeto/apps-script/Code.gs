var APP_HTML = "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><base target=\"_top\"><title>Drones - Muito Além do Voo</title><style>\n:root{--red:#e60029;--ink:#10333b;--muted:#586e73;--bg:#f3f5f1;--lime:#d8f19a}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,Arial,sans-serif}button,input,select,textarea{font:inherit}button,a.button{cursor:pointer;border:0;border-radius:9px;background:var(--ink);color:white;padding:11px 16px;font-weight:650;display:inline-block;text-decoration:none}button:disabled{opacity:.5;cursor:wait}button.secondary{background:#e8efeb;color:var(--ink)}button.red{background:var(--red)}a{color:#00677a}input,select,textarea{width:100%;padding:11px;border:1px solid #becdc9;border-radius:7px;background:white;color:var(--ink)}input[type=checkbox],input[type=radio]{width:auto;margin-right:9px}label{display:block;margin:12px 0}label small{display:block;color:var(--muted)}header{background:white;border-top:5px solid var(--red);border-bottom:1px solid #dbe4df}.wrap{max-width:1160px;margin:auto;padding:22px}.brand{display:flex;align-items:center;gap:14px}.brand img{width:45px;height:50px;object-fit:contain}.brand b{display:block;font-size:18px}.brand span{font-size:13px;color:var(--muted)}nav{display:flex;gap:9px;flex-wrap:wrap;margin-top:17px}nav button{padding:8px 12px;background:#eef2ee;color:var(--ink)}main{min-height:75vh}h1{font-size:clamp(30px,5vw,48px);line-height:1.1;letter-spacing:-1.5px;margin:12px 0 18px}h2{font-size:24px;line-height:1.25}h3{margin-top:0}.eyebrow{color:var(--red);font-size:12px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase}.lead{font-size:19px;color:var(--muted);max-width:750px}.card{background:white;padding:24px;border-radius:15px;border:1px solid #dde6df;margin:18px 0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.grid .card{margin:0}.narrow{max-width:600px;margin:auto}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:15px 0}.notice{padding:13px 17px;border-radius:8px;background:#e7efeb;color:var(--ink);margin:15px 0}.error{background:#ffe5e9;color:#8e001d}.success{background:#e0f0d1}#status{position:sticky;top:0;z-index:10}.muted,small{color:var(--muted)}.stat{font-size:35px;font-weight:800}.tag{font-size:12px;padding:4px 9px;background:#e9efe9;border-radius:20px;display:inline-block}.lesson-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.lesson{background:white;text-align:left;color:var(--ink);border:1px solid #dce3de;padding:17px;font-weight:500;min-height:135px}.lesson strong{display:block;margin:7px 0}.lesson.done{border-color:#97bd6b;background:#f1f8e8}.lesson .tag{margin-bottom:2px}.player{aspect-ratio:16/9;max-width:900px;background:#132f36;border-radius:10px;overflow:hidden}.player iframe{width:100%;height:100%}progress{width:100%;height:13px;accent-color:#477d43}.person{width:100%;text-align:left;margin:7px 0;background:#f1f5f0;color:var(--ink);border:1px solid #dce5de}.person b{display:block}.question{padding:22px 0;border-bottom:1px solid #dbe4dd}.question label{padding:9px;background:#f2f5f0;border-radius:7px}.question input{vertical-align:middle}details{margin:16px 0}summary{cursor:pointer;font-weight:700}table{border-collapse:collapse;width:100%;font-size:14px}td,th{text-align:left;vertical-align:top;padding:9px;border-bottom:1px solid #dce4de}footer{padding:30px;text-align:center;color:var(--muted);font-size:13px}#clock{font-weight:800;color:var(--red)}.key{overflow-wrap:anywhere;font-family:monospace;background:#fff8cf;padding:15px;user-select:all}.bank-question{margin-bottom:22px}#calibration{max-width:650px}.choice-correct{border-left:3px solid #4d8a38;padding-left:12px}.download{margin-top:8px}textarea{min-height:100px}@media(max-width:750px){.grid{grid-template-columns:1fr}.lesson-list{grid-template-columns:repeat(2,minmax(0,1fr))}.wrap{padding:17px}.card{padding:18px}table{font-size:12px}td,th{padding:6px}}@media(max-width:450px){.lesson-list{grid-template-columns:1fr}nav button{font-size:13px}}\n</style></head><body><header><div class=\"wrap\"><div class=\"brand\"><img src=\"https://newtonlicciardijr.github.io/drones/assets/brand/mackenzie-simbolo.png\" alt=\"Mackenzie\"><div><b>DRONES · MUITO ALÉM DO VOO</b><span>Universidade Presbiteriana Mackenzie · Escola de Engenharia</span></div></div><nav id=\"nav\"><a class=\"button\" href=\"https://newtonlicciardijr.github.io/drones/\">Portal do curso</a></nav></div></header><main class=\"wrap\"><div id=\"status\" role=\"status\" aria-live=\"polite\"></div><div id=\"app\"><div class=\"card\"><p class=\"eyebrow\">ÁREA DO CURSO</p><h1>Conectando sua trilha.</h1><p>Carregando seus registros...</p></div></div></main><footer>Prof. Dr. Newton · Prof. Dr. Jucá<br>30 h/a · Engenharia, aplicações e sociedade.<br><a href=\"https://newtonlicciardijr.github.io/drones/certificado.html\">Modelo do certificado · frente e verso</a></footer>\n<script src=\"https://www.youtube.com/iframe_api\" async></script>\n<script>\n'use strict';\nconst initialView='__INITIAL_VIEW__';\nconst $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nlet token='',me=null,lessons=[],bank=[],exam=null,serverOffset=0,player=null,watch=null,heartbeatTimer=null,clockTimer=null,calibration=null,pendingBeat=false,registrationOpen=false;\ntry{token=sessionStorage.getItem('dmav-session')||'';}catch(e){}\nfunction notice(message,error=false){$('status').innerHTML=message?`<div class=\"notice ${error?'error':''}\">${esc(message)}</div>`:'';}\nfunction setToken(v){token=v||'';try{if(token)sessionStorage.setItem('dmav-session',token);else sessionStorage.removeItem('dmav-session');}catch(e){}}\nfunction rpc(action,data={}){return new Promise((resolve,reject)=>{google.script.run.withSuccessHandler(r=>{if(r&&r.ok)resolve(r.data);else reject(Error(r?.error||'Não foi possível concluir a operação.'));}).withFailureHandler(()=>reject(Error('Falha de conexão. Tente novamente.'))).api({action,data,token});});}\nasync function task(button,fn){if(button)button.disabled=true;notice('Processando...');try{await fn();if($('status').textContent==='Processando...')notice('');}catch(e){notice(e.message,true);}finally{if(button)button.disabled=false;}}\nfunction date(v){return v?new Date(Number(v)).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'}):'—';}\nfunction stopPlayer(){if(heartbeatTimer)clearInterval(heartbeatTimer);heartbeatTimer=null;watch=null;if(player){try{player.destroy();}catch(e){}player=null;}calibration=null;}\nfunction stopClock(){if(clockTimer)clearInterval(clockTimer);clockTimer=null;}\nfunction view(html){stopPlayer();stopClock();$('app').innerHTML=html;window.scrollTo(0,0);}\nfunction nav(){const teacher=me&&['owner','teacher'].includes(me.account.role);$('nav').innerHTML=`<a class=\"button\" href=\"https://newtonlicciardijr.github.io/drones/\">Portal do curso</a>${me?`<button onclick=\"home()\">Minha trilha</button>${teacher?'<button onclick=\"openAdmin()\">Coordenação</button><button onclick=\"openBank()\">Avaliação docente</button>':''}<button onclick=\"logout()\">Sair</button>`:''}`;}\nasync function boot(){try{const r=await rpc('bootstrap');registrationOpen=!!r.registrationOpen;if(!r.authenticated){setToken('');loginView();return;}me=r;lessons=r.lessons;serverOffset=r.serverNow-Date.now();nav();if(initialView==='bank'&&['owner','teacher'].includes(me.account.role))await openBank();else if(['owner','teacher'].includes(me.account.role))await openAdmin();else home();}catch(e){setToken('');loginView();notice(e.message,true);}}\nfunction loginView(mode='login'){me=null;nav();view(`<div class=\"narrow\"><p class=\"eyebrow\">ÁREA DO CURSO</p><h1>${mode==='register'?'Sua missão começa aqui.':mode==='recover'?'Recuperar acesso.':'Retome sua trilha.'}</h1><p class=\"lead\">Aulas, avaliação e registros em um só lugar.</p><section class=\"card\"><form id=\"auth\" onsubmit=\"authSubmit(event,'${mode}')\"><label>E-mail<input type=\"email\" name=\"email\" autocomplete=\"username\" required maxlength=\"254\"></label><label>${mode==='recover'?'Nova senha':'Senha'}<input type=\"password\" name=\"password\" minlength=\"12\" maxlength=\"128\" autocomplete=\"${mode==='login'?'current-password':'new-password'}\" required><small>De 12 a 128 caracteres.</small></label>${mode==='register'?`<label>Nome completo para o certificado<input name=\"fullName\" required maxlength=\"180\"></label><label>Como prefere ser chamado<input name=\"preferredName\" required maxlength=\"80\"></label><label>Data de nascimento<input name=\"birthDate\" type=\"date\" required></label><label>Código de convite docente, se recebeu um<input name=\"invitation\" autocomplete=\"off\" maxlength=\"64\"></label><label><input type=\"checkbox\" name=\"consent\" required>Estou ciente do uso dos meus dados para cadastro, acompanhamento, avaliação e certificação deste curso. Os registros e documentos são privados e acessíveis aos docentes autorizados.</label>`:''}${mode==='recover'?'<label>Chave de recuperação<input name=\"recoveryKey\" required minlength=\"64\" maxlength=\"64\" autocomplete=\"off\"><small>Use a chave fornecida ao criar a conta.</small></label>':''}<button type=\"submit\">${mode==='register'?'Criar conta':mode==='recover'?'Recuperar acesso':'Entrar'}</button></form><div class=\"actions\">${mode!=='login'?'<button class=\"secondary\" onclick=\"loginView()\">Já tenho conta</button>':''}${mode!=='register'?'<button class=\"secondary\" onclick=\"loginView(\\'register\\')\">Criar conta</button>':''}${mode!=='recover'?'<button class=\"secondary\" onclick=\"loginView(\\'recover\\')\">Recuperar acesso</button>':''}</div><p class=\"muted\">Docentes: usem o acesso Google do proprietário ou o convite privado fornecido pela coordenação. Uma conta comum não concede acesso docente.</p></section></div>`);}\nasync function authSubmit(e,mode){e.preventDefault();const f=new FormData(e.target),data=Object.fromEntries(f);data.consent=f.get('consent')==='on';await task(e.submitter,async()=>{const r=await rpc(mode,data);setToken(r.token);const key=r.recoveryKey;await refresh();nav();if(key)view(`<div class=\"narrow card\"><p class=\"eyebrow\">ACESSO CRIADO</p><h1>Guarde sua chave.</h1><p>Ela permite recuperar sua senha. Copie para um local privado antes de continuar.</p><div class=\"key\">${esc(key)}</div><p>Os professores não conseguem consultar sua senha nem reenviar esta chave.</p><button onclick=\"home()\">Chave guardada · continuar</button></div>`);else home();});}\nasync function refresh(){me=await rpc('me');lessons=me.lessons;serverOffset=me.serverNow-Date.now();}\nasync function logout(){await task(null,async()=>{await rpc('logout');setToken('');me=null;loginView();});}\nfunction home(){if(!me)return loginView();nav();const p=me.participant;if(!p){view(`<p class=\"eyebrow\">ACESSO DOCENTE</p><h1>Ensinar, acompanhar e validar.</h1><div class=\"card\"><p>Seu acesso é docente. A simulação permite testar a avaliação sem criar uma inscrição nem consumir tentativas.</p><div class=\"actions\"><button onclick=\"openAdmin()\">Acompanhar participantes</button><button onclick=\"openBank()\">Examinar e simular a prova</button></div></div>`);return;}const eligibility=me.eligibility;view(`<p class=\"eyebrow\">MINHA TRILHA · ${esc(p.preferred_name)}</p><h1>Da missão à decisão.</h1><p class=\"lead\">${eligibility.completed} de 17 aulas concluídas. Acompanhe as aulas por este player para registrar sua evolução.</p><div class=\"grid\"><section class=\"card\"><div class=\"stat\">${eligibility.completed}<small> / 17</small></div><progress max=\"17\" value=\"${eligibility.completed}\"></progress><p>Curso de extensão · 30 h/a</p><p class=\"muted\">Os registros de reprodução indicam trechos assistidos; não comprovam atenção humana.</p></section><section class=\"card\"><h2>Avaliação final</h2><p>20 questões · mínimo de 70% · até 3 tentativas na mesma janela de 2 horas.</p><p>${esc(eligibility.reason||'Aulas concluídas. Você pode iniciar ou retomar sua avaliação.')}</p>${eligibility.canStart?'<button onclick=\"startExam(this)\">Iniciar ou retomar avaliação</button>':''}${p.passed_at?`<div class=\"notice success\">Aprovado · ${esc(p.passed_score)}%</div>`:''}<p><small>Sair da página não pausa o prazo.</small></p></section></div><h2>As 17 aulas</h2><div class=\"lesson-list\">${lessons.map((l,i)=>{const pr=me.progress.find(x=>x.lesson_id===l.id),done=!!pr?.completed_at,percent=Math.min(100,Math.round(100*(Number(pr?.watched_seconds)||0)/l.duration));return `<button class=\"lesson ${done?'done':''}\" onclick=\"openLesson('${l.id}')\"><span class=\"tag\">${String(i+1).padStart(2,'0')} · ${done?'Concluída':percent+'% registrado'}</span><strong>${esc(l.title)}</strong><small>${Math.round(l.duration/60)} min · assistir</small></button>`;}).join('')}</div><section class=\"card\"><h2>Documentação e certificado</h2><p>Envie o documento ANAC solicitado pela coordenação. A conferência é humana; o envio não gera aprovação automática.</p>${me.documents.filter(x=>x.status!=='superseded').map(d=>`<div class=\"notice\">${esc(d.kind)} · ${esc(d.status)}${d.note?'<br>'+esc(d.note):''}</div>`).join('')}<form onsubmit=\"uploadDocument(event)\"><div class=\"grid\"><label>Tipo do documento<input name=\"kind\" placeholder=\"Ex.: CANAC\" required maxlength=\"100\"></label><label>Identificador no documento<input name=\"identifier\" required maxlength=\"100\"></label></div><label>Prefixo da aeronave, se aplicável<input name=\"prefix\" maxlength=\"40\"></label><label>Arquivo PDF, PNG ou JPEG · até 5 MB<input name=\"file\" type=\"file\" accept=\"application/pdf,image/png,image/jpeg\" required></label><button>Enviar para conferência</button></form>${me.certificates.map(c=>`<p><button onclick=\"downloadFile('certificate','${c.id}',this)\">Baixar meu certificado</button></p>`).join('')}<p class=\"muted\">A emissão depende da conclusão das aulas, aprovação na prova, documentação conferida e autorização institucional registrada.</p></section><section class=\"card\"><h2>Meu histórico de avaliação</h2>${me.attempts.length?`<table><tr><th>Início</th><th>Situação</th><th>Nota</th></tr>${me.attempts.map(a=>`<tr><td>${date(a.started_at)}</td><td>${esc(a.status)}</td><td>${a.score===''?'—':esc(a.score)+'%'}</td></tr>`).join('')}</table>`:'<p>Nenhuma tentativa registrada.</p>'}</section>`);}\nlet ytReady;\nfunction youtube(){if(window.YT?.Player)return Promise.resolve();if(!ytReady)ytReady=new Promise((resolve,reject)=>{let ticks=0;const timer=setInterval(()=>{if(window.YT?.Player){clearInterval(timer);resolve();}else if(++ticks>100){clearInterval(timer);ytReady=null;reject(Error('Não foi possível carregar o player do YouTube. Atualize a página.'));}},200);});return ytReady;}\nasync function openLesson(id){const l=lessons.find(x=>x.id===id);if(!l)return;view(`<p class=\"eyebrow\">AULA · MINHA TRILHA</p><h1>${esc(l.title)}</h1><div id=\"video\" class=\"player\"></div><div id=\"watchStatus\" class=\"notice\">Preparando o player do YouTube...</div><p>Assista normalmente. Saltos na reprodução não são contabilizados como trechos assistidos.</p><div class=\"actions\"><button class=\"secondary\" onclick=\"returnHome()\">Voltar à trilha</button><a class=\"button\" href=\"https://newtonlicciardijr.github.io/drones${esc(l.page)}\">Materiais desta aula</a></div>`);await youtube();let started=false;player=new YT.Player('video',{videoId:l.youtubeId,width:'100%',height:'100%',playerVars:{playsinline:1,rel:0,origin:location.origin},events:{onReady:()=>{$('watchStatus').textContent='Clique em reproduzir para registrar a aula.';},onStateChange:async e=>{if(e.data===1&&!started){started=true;try{const s=await rpc('watch/start',{lessonId:id,duration:player.getDuration(),position:player.getCurrentTime()});watch=s;heartbeatTimer=setInterval(()=>beat(true),20000);$('watchStatus').textContent='Registro ativo. Seus trechos são salvos durante a reprodução.';}catch(err){started=false;notice(err.message,true);}}else if(e.data===2||e.data===0)beat(true);},onError:e=>{notice('O YouTube não conseguiu abrir este vídeo (código '+e.data+'). Verifique a conexão e avise os professores se persistir.',true);}}});}\nasync function beat(event=false){if(!watch||pendingBeat||!player)return;const state=player.getPlayerState();if(!event&&state!==1)return;pendingBeat=true;try{const r=await rpc('watch/beat',{id:watch.id,position:player.getCurrentTime(),rate:player.getPlaybackRate(),playing:state===1||state===0||state===2});if($('watchStatus'))$('watchStatus').textContent=r.completed?'Aula concluída e registrada.':Math.min(100,Math.round(100*r.watched_seconds/r.duration))+'% registrado · salvamento ativo';}catch(e){notice(e.message,true);}finally{pendingBeat=false;}}\nasync function returnHome(){if(watch)await beat(true);await task(null,async()=>{await refresh();home();});}\nasync function startExam(button){await task(button,async()=>{exam=await rpc('exam/start');serverOffset=exam.serverNow-Date.now();view(`<p class=\"eyebrow\">AVALIAÇÃO FINAL</p><h1>Decida com fundamento.</h1><div class=\"notice\">Tempo restante: <span id=\"clock\"></span><br>20 questões. Todas devem ser respondidas antes do envio.</div><form id=\"exam\" class=\"card\" onsubmit=\"submitExam(event)\">${exam.questions.map((q,i)=>`<section class=\"question\"><h3>${i+1}. ${esc(q.prompt)}</h3>${q.choices.map(c=>`<label><input type=\"radio\" name=\"${q.id}\" value=\"${c.id}\" required>${esc(c.label)}</label>`).join('')}</section>`).join('')}<div class=\"actions\"><button type=\"submit\">Enviar avaliação</button><button type=\"button\" class=\"secondary\" onclick=\"returnHome()\">Sair e retomar depois</button></div><small>Sair não pausa a janela de duas horas.</small></form>`);const tick=()=>{const s=Math.max(0,Math.floor((exam.deadline-Date.now()-serverOffset)/1000));if($('clock'))$('clock').textContent=`${Math.floor(s/3600)}h ${Math.floor(s%3600/60)}min ${s%60}s`;if(s===0){stopClock();notice('O prazo terminou. Atualize sua trilha para consultar a situação.',true);}};tick();clockTimer=setInterval(tick,1000);});}\nasync function submitExam(e){e.preventDefault();await task(e.submitter,async()=>{const r=await rpc('exam/submit',{id:exam.id,answers:Object.fromEntries(new FormData(e.target))});await refresh();home();notice(`${r.passed?'Aprovado!':'Nota mínima ainda não alcançada.'} Resultado: ${r.score}%.`);});}\nasync function uploadDocument(e){e.preventDefault();const f=new FormData(e.target),file=f.get('file');await task(e.submitter,async()=>{if(!file||file.size>5*1024*1024)throw Error('Envie um arquivo de até 5 MB.');const base64=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result).split(',')[1]);r.onerror=reject;r.readAsDataURL(file);});await rpc('document/upload',{kind:f.get('kind'),identifier:f.get('identifier'),prefix:f.get('prefix'),base64});await refresh();home();notice('Documento recebido para conferência.');});}\nfunction download(name,mime,content,base64=false){const raw=base64?Uint8Array.from(atob(content),c=>c.charCodeAt(0)):content,blob=new Blob([raw],{type:mime}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),15000);}\nasync function downloadFile(type,id,button){await task(button,async()=>{const r=await rpc('file',{type,id});download(r.name,r.mime,r.base64,true);});}\nasync function openAdmin(){await task(null,async()=>{const d=await rpc('admin/list');lessons=d.lessons;view(`<p class=\"eyebrow\">COORDENAÇÃO · ACESSO RESTRITO</p><h1>Da conferência à conclusão.</h1><p class=\"lead\">${d.participants.length} inscrições · registros privados no Google.</p><div class=\"actions\"><button onclick=\"exportCsv(this)\">Baixar acompanhamento · CSV</button><button class=\"secondary\" onclick=\"openBank()\">Examinar e simular avaliação</button><button class=\"secondary\" onclick=\"showAudit(this)\">Consultar auditoria</button><a class=\"button\" href=\"https://newtonlicciardijr.github.io/drones/certificado.html\">Conferir certificado · frente e verso</a></div><div class=\"grid\"><section class=\"card\"><h2>Participantes</h2>${d.participants.map(p=>`<button class=\"person\" onclick=\"participantDetail('${esc(p.id)}',this)\"><b>${esc(p.full_name)}</b><span>${esc(p.status)} · ${p.completed}/17 aulas · ${p.attempts} tentativa(s)</span></button>`).join('')||'<p>Nenhuma inscrição.</p>'}</section><section class=\"card\" id=\"detail\"><h2>Escolha uma inscrição</h2><p>Consulte o acompanhamento por aula, as tentativas, a documentação e a situação do certificado.</p></section></div>${me.account.role==='owner'?`<details class=\"card\"><summary>Autorização institucional de emissão</summary><p>O modelo utiliza 30 h/a. Registre a aprovação somente após receber a autorização da Coordenação de Extensão.</p><form onsubmit=\"saveSettings(event)\"><label>Referência da autorização<input name=\"reference\" maxlength=\"300\" value=\"${esc(d.settings.extensionApprovalReference||'')}\"></label><label><input name=\"approved\" type=\"checkbox\" ${d.settings.templateApproved==='true'?'checked':''}>A Coordenação de Extensão aprovou o modelo e autorizou a emissão nesta oferta.</label><button>Salvar configuração de emissão</button></form></details><details class=\"card\"><summary>Acesso do Prof. Jucá e outros docentes</summary><p>Gere um convite para o e-mail confirmado do docente. Entregue o código por um canal privado. Ele deverá criar a própria senha usando esse e-mail e o código no formulário de cadastro. O convite vence em sete dias e só pode ser usado uma vez.</p><form onsubmit=\"inviteTeacher(event)\"><label>E-mail do docente<input name=\"email\" type=\"email\" required></label><button>Gerar convite privado</button></form><div id=\"invitation\"></div></details><details class=\"card\"><summary>Manutenção dos vídeos no YouTube</summary><p>A conferência consulta as durações dos 17 vídeos pelo player oficial, sem alterar publicações nem marcar aulas como concluídas.</p><button onclick=\"calibrateVideos(this)\">Conferir durações dos 17 vídeos</button><div id=\"calibrationStatus\"></div><div id=\"calibration\" class=\"player\" style=\"display:none\"></div></details>`:''}<div id=\"audit\"></div>`);});}\nasync function participantDetail(id,button){await task(button,async()=>{const d=await rpc('admin/detail',{id}),p=d.participant;$('detail').innerHTML=`<p class=\"eyebrow\">INSCRIÇÃO</p><h2>${esc(p.full_name)}</h2><p>${esc(p.email)}<br>Nascimento: ${esc(p.birth_date)}<br>Preferência: ${esc(p.preferred_name)}</p><p>Nota: ${p.passed_score===''?'—':esc(p.passed_score)+'%'} · Aprovação: ${date(p.passed_at)}</p><details open><summary>Acompanhamento por aula e tentativa</summary><table><tr><th>Aula</th><th>Situação</th></tr>${lessons.map(l=>{const pr=d.progress.find(x=>x.lesson_id===l.id);return `<tr><td>${esc(l.title)}</td><td>${pr?.completed_at?'Concluída · '+date(pr.completed_at):Math.min(100,Math.round(100*(pr?.watched_seconds||0)/l.duration))+'% registrado'}</td></tr>`;}).join('')}</table><p>${d.attempts.length} tentativa(s) registrada(s).</p>${d.attempts.map(a=>`<p>${date(a.started_at)} · ${esc(a.status)} · ${a.score===''?'sem nota':esc(a.score)+'%'}</p>`).join('')}</details><h3>Documentação</h3>${d.documents.filter(x=>x.status!=='superseded').map(doc=>`<p>${esc(doc.kind)} · ${esc(doc.identifier)} · ${esc(doc.status)}<br>${esc(doc.note||'')}</p><button class=\"secondary\" onclick=\"downloadFile('document','${doc.id}',this)\">Baixar documento para conferência</button>${!d.certificates.length?`<form onsubmit=\"reviewDocument(event,'${doc.id}','${p.id}')\"><label>Parecer da conferência<textarea name=\"note\" minlength=\"8\" maxlength=\"1000\" required></textarea></label><label>Situação<select name=\"status\"><option value=\"rejected\">Solicitar correção</option><option value=\"approved\">Aprovar documento conferido</option></select></label><button>Registrar parecer</button></form>`:''}`).join('')||'<p>Documento não enviado.</p>'}<h3>Certificado</h3>${d.certificates.map(c=>`<p>${esc(c.id)} · ${date(c.issued_at)}</p><button onclick=\"downloadFile('certificate','${c.id}',this)\">Baixar certificado</button>`).join('')||`<p>A emissão exige 17 aulas, aprovação, documentação conferida e autorização institucional.</p><button onclick=\"issueCertificate('${p.id}',this)\">Emitir após conferir os requisitos</button>`}${!p.passed_at?`<details><summary>Reabertura excepcional da avaliação</summary><form onsubmit=\"reopenExam(event,'${p.id}')\"><label>Justificativa<textarea name=\"reason\" minlength=\"12\" maxlength=\"500\" required></textarea></label><button class=\"red\">Registrar exceção e reabrir</button></form></details>`:''}`;});}\nasync function saveSettings(e){e.preventDefault();const f=new FormData(e.target);await task(e.submitter,async()=>{await rpc('admin/settings',{reference:f.get('reference'),approved:f.get('approved')==='on'});notice('Configuração registrada.');});}\nasync function reviewDocument(e,id,participantId){e.preventDefault();const data=Object.fromEntries(new FormData(e.target));await task(e.submitter,async()=>{await rpc('admin/reviewDocument',{id,...data});await participantDetail(participantId);});}\nasync function reopenExam(e,id){e.preventDefault();const f=new FormData(e.target);await task(e.submitter,async()=>{await rpc('admin/reopen',{id,reason:f.get('reason')});await openAdmin();});}\nasync function issueCertificate(id,button){await task(button,async()=>{const r=await rpc('admin/issue',{id});await participantDetail(id);notice('Certificado registrado: '+r.id);});}\nasync function exportCsv(button){await task(button,async()=>{const r=await rpc('admin/export');download('Drones-acompanhamento.csv','text/csv;charset=utf-8',r.csv);});}\nasync function showAudit(button){await task(button,async()=>{const r=await rpc('admin/audit');$('audit').innerHTML=`<section class=\"card\"><h2>Registros de auditoria</h2><table><tr><th>Data</th><th>Responsável</th><th>Ação</th></tr>${r.map(x=>`<tr><td>${date(x.at)}</td><td>${esc(x.actor)}</td><td>${esc(x.action)}<br><small>${esc(x.detail_json)}</small></td></tr>`).join('')}</table></section>`;});}\nasync function inviteTeacher(e){e.preventDefault();await task(e.submitter,async()=>{const r=await rpc('admin/invite',Object.fromEntries(new FormData(e.target)));$('invitation').innerHTML=`<p>Convite para ${esc(r.email)} · válido até ${date(r.expiresAt)}.</p><div class=\"key\">${esc(r.invitation)}</div><p>Envie este código apenas ao docente indicado. Ele não concede acesso à pasta inteira do Drive.</p>`;});}\nasync function openBank(){await task(null,async()=>{const d=await rpc('admin/bank');bank=d.questions;view(`<p class=\"eyebrow\">AVALIAÇÃO · ÁREA DOCENTE</p><h1>Examinar, testar e revisar.</h1><p class=\"lead\">${bank.length} questões no banco privado. As provas reais sorteiam 20 questões e embaralham as alternativas.</p><div class=\"actions\"><button onclick=\"simulationView()\">Simular uma prova de 20 questões</button><button class=\"secondary\" onclick=\"openAdmin()\">Voltar à coordenação</button></div><p>Os gabaritos e as explicações abaixo são exclusivos dos docentes. Pareceres não alteram automaticamente as questões.</p>${bank.map(q=>`<section class=\"card bank-question\"><span class=\"tag\">${esc(q.id)} · ${esc(q.topic)}</span><h2>${esc(q.prompt)}</h2><ol type=\"A\">${q.choices.map((c,i)=>`<li class=\"${i===q.correct?'choice-correct':''}\">${esc(c)}${i===q.correct?' <b>· Gabarito</b>':''}</li>`).join('')}</ol><p><b>Explicação:</b> ${esc(q.explanation)}</p><details><summary>Registrar parecer docente</summary><form onsubmit=\"questionReview(event,'${q.id}')\"><label>Parecer<select name=\"status\"><option value=\"approved\">Aprovada</option><option value=\"revise\">Ajustar</option><option value=\"rejected\">Rejeitada</option></select></label><label>Justificativa<textarea name=\"note\" minlength=\"8\" maxlength=\"2000\" required></textarea></label><button>Registrar parecer</button></form>${d.reviews.filter(r=>r.question_id===q.id).map(r=>`<p><small>${esc(r.reviewer)} · ${date(r.updated_at)} · ${esc(r.status)}</small><br>${esc(r.note)}</p>`).join('')}</details><details><summary>Substituir esta questão no banco</summary><p>Preserva uma cópia privada do banco anterior. Provas já iniciadas mantêm as questões e o gabarito daquele momento.</p><form onsubmit=\"replaceQuestion(event,'${q.id}')\"><label>Questão em formato JSON<textarea name=\"question\" rows=\"12\" required>${esc(JSON.stringify(q,null,2))}</textarea></label><label>Justificativa da substituição<textarea name=\"reason\" minlength=\"12\" maxlength=\"500\" required></textarea></label><button class=\"red\">Salvar substituição no banco</button></form></details></section>`).join('')}`);});}\nfunction simulationView(){const qs=bank.slice(0,20);view(`<p class=\"eyebrow\">SIMULAÇÃO DOCENTE</p><h1>Teste sem consumir tentativas.</h1><p>Esta simulação usa as primeiras 20 questões para facilitar a conferência. As provas reais fazem sorteio e embaralhamento.</p><form class=\"card\" onsubmit=\"submitSimulation(event)\">${qs.map((q,i)=>`<section class=\"question\"><h3>${i+1}. ${esc(q.prompt)}</h3>${q.choices.map((c,j)=>`<label><input type=\"radio\" name=\"${q.id}\" value=\"${j}\" required>${esc(c)}</label>`).join('')}</section>`).join('')}<button>Corrigir simulação</button></form><button class=\"secondary\" onclick=\"openBank()\">Voltar ao banco</button>`);}\nasync function submitSimulation(e){e.preventDefault();const f=Object.fromEntries(new FormData(e.target));Object.keys(f).forEach(k=>f[k]=Number(f[k]));await task(e.submitter,async()=>{const r=await rpc('admin/simulate',{answers:f});view(`<section class=\"card\"><p class=\"eyebrow\">RESULTADO DA SIMULAÇÃO</p><h1>${r.score}%</h1><p>Nenhuma tentativa real foi criada e nenhuma inscrição foi aprovada por esta simulação.</p><button onclick=\"openBank()\">Retornar ao banco e aos gabaritos</button></section>`);});}\nasync function questionReview(e,id){e.preventDefault();const f=Object.fromEntries(new FormData(e.target));await task(e.submitter,async()=>{await rpc('admin/questionReview',{id,...f});await openBank();});}\nasync function replaceQuestion(e,id){e.preventDefault();const f=new FormData(e.target);await task(e.submitter,async()=>{const question=JSON.parse(f.get('question'));if(question.id!==id)throw Error('Mantenha o identificador da questão.');await rpc('admin/replaceQuestion',{question,reason:f.get('reason')});await openBank();});}\nasync function calibrateVideos(button){button.disabled=true;stopPlayer();$('calibration').style.display='block';$('calibrationStatus').textContent='Consultando os vídeos no YouTube...';await youtube();let index=0,saved=false,lastChange=Date.now();calibration={active:true};const next=()=>{index++;saved=false;lastChange=Date.now();if(index>=lessons.length){clearInterval(heartbeatTimer);heartbeatTimer=null;player.destroy();player=null;$('calibrationStatus').textContent='Conferência concluída: 17 de 17 vídeos. Durações salvas.';$('calibration').style.display='none';button.disabled=false;return;}player.loadVideoById(lessons[index].youtubeId);player.mute();};player=new YT.Player('calibration',{width:'100%',height:'100%',videoId:lessons[0].youtubeId,playerVars:{autoplay:1,mute:1,playsinline:1,origin:location.origin},events:{onReady:()=>{player.mute();player.playVideo();},onError:e=>{clearInterval(heartbeatTimer);notice('Não foi possível conferir '+lessons[index].title+' (YouTube '+e.data+').',true);button.disabled=false;}}});heartbeatTimer=setInterval(async()=>{if(!player||saved)return;if(Date.now()-lastChange>30000){clearInterval(heartbeatTimer);notice('Tempo excedido ao consultar '+lessons[index].title+'. Tente novamente.',true);button.disabled=false;return;}const data=player.getVideoData(),duration=player.getDuration();if(data?.video_id!==lessons[index].youtubeId||!duration)return;saved=true;try{const r=await rpc('admin/calibrate',{id:lessons[index].id,duration});$('calibrationStatus').textContent=`${r.count}/17 conferidos · ${lessons[index].title} · ${duration}s`;next();}catch(e){clearInterval(heartbeatTimer);notice(e.message,true);button.disabled=false;}},1200);}\nboot();\n</script></body></html>\n";

/** Drones - operational application. Private values and question bank stay in Google.
 * All RPC operations authorize on the server. Helpers ending in _ are not RPC-callable.
 */
var RULES = Object.freeze({hours:30,lessonCount:17,questionCount:20,passScore:70,maxAttempts:3,windowSeconds:7200});
var SCHEMA = {
 Participants:['id','email','full_name','preferred_name','birth_date','created_at','consent_at','status','identity_hash','updated_at','cycle','window_started_at','passed_at','passed_score'],
 LessonProgress:['participant_id','lesson_id','intervals_json','watched_seconds','completed_at','updated_at'],
 Attempts:['id','participant_id','cycle','started_at','deadline','submitted_at','status','score','questions_json','answers_json','answer_key_json'],
 Documents:['id','participant_id','private_file_id','kind','status','reviewed_by','reviewed_at','identifier','aircraft_prefix','note','mime','created_at'],
 Certificates:['id','participant_id','private_file_id','issued_at','issued_by','authorization_reference'],
 TeacherReviews:['id','question_id','reviewer','status','note','updated_at'],
 Audit:['id','actor','action','target','at','detail_json'],
 CourseSettings:['key','value'],
 Accounts:['id','email','password_hash','recovery_hash','role','created_at','updated_at'],
 Sessions:['token_hash','account_id','created_at','expires_at'],
 WatchSessions:['id','participant_id','lesson_id','started_at','last_position','last_at','credited_seconds','duration','expires_at'],
 Invitations:['id','email','token_hash','role','expires_at','used_at','created_by']
};
var STORE_, BOOK_, NOW_;
function props_(){return PropertiesService.getScriptProperties();}
function now_(){return NOW_===undefined?Date.now():NOW_;}
function require_(ok,message){if(!ok)throw new Error(message);}
function ownerContext_(){var expected=String(props_().getProperty('OWNER_EMAIL')||'').toLowerCase();var actual=String(Session.getActiveUser().getEmail()||'').toLowerCase();require_(expected&&actual&&actual===expected,'Acesso restrito ao proprietário.');return {id:'owner',email:actual,role:'owner'};}
function ownerMaybe_(){try{return ownerContext_();}catch(e){return null;}}
function lock_(fn){var l=LockService.getScriptLock();l.waitLock(30000);try{STORE_=null;BOOK_=null;return fn();}finally{STORE_=null;BOOK_=null;l.releaseLock();}}
function book_(){if(!BOOK_)BOOK_=SpreadsheetApp.openById(props_().getProperty('COURSE_SHEET_ID'));return BOOK_;}
function store_(){return STORE_||(STORE_={});}
function table_(n){var cache=store_();if(!cache[n]){var s=book_().getSheetByName(n);require_(s,'Estrutura incompleta: '+n);var v=s.getDataRange().getValues();require_(JSON.stringify(v[0])===JSON.stringify(SCHEMA[n]),'Cabeçalhos incompatíveis: '+n);cache[n]={sheet:s,rows:v.slice(1).map(function(r,i){var o={};SCHEMA[n].forEach(function(k,j){o[k]=r[j]===undefined?'':r[j];});o._row=i+2;return o;}).filter(function(o){return o[SCHEMA[n][0]]!=='';})};}return cache[n];}
function rows_(n){return table_(n).rows;}
function safeCell_(v){if(v===null||v===undefined)return '';return typeof v==='string'&&/^[=+\-@]/.test(v)?"'"+v:v;}
function save_(n,o){var t=table_(n),v=SCHEMA[n].map(function(k){return safeCell_(o[k]);});if(o._row)t.sheet.getRange(o._row,1,1,v.length).setValues([v]);else{o._row=t.sheet.getLastRow()+1;t.sheet.getRange(o._row,1,1,v.length).setValues([v]);t.rows.push(o);}return o;}
function clean_(s,n){return String(s===undefined?'':s).normalize('NFC').trim().slice(0,n||200);}
function email_(s){return clean_(s,254).toLowerCase();}
function hex_(a){return Array.from(a,function(v){return (v&255).toString(16).padStart(2,'0');}).join('');}
function bytes_(s){return new Uint8Array(Utilities.newBlob(String(s)).getBytes().map(function(x){return x&255;}));}
function hash_(s){return hex_(CourseCrypto.sha256(bytes_(s)));}
function random_(){return (Utilities.getUuid()+Utilities.getUuid()).replace(/-/g,'');}
function id_(){return Utilities.getUuid();}
function equal_(a,b){a=String(a||'');b=String(b||'');var x=a.length^b.length;for(var i=0;i<Math.max(a.length,b.length);i++)x|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return x===0;}
function passwordValid_(s){require_(typeof s==='string'&&s.length>=12&&s.length<=128,'Use uma senha de 12 a 128 caracteres.');}
function derive_(s,salt){return hex_(CourseCrypto.pbkdf2(CourseCrypto.sha256,bytes_(s),bytes_(salt),{c:600000,dkLen:32}));}
function passwordHash_(s){var salt=random_();return salt+':'+derive_(s,salt);}
function passwordMatches_(s,value){var parts=String(value||'0'.repeat(64)+':'+ '0'.repeat(64)).split(':');return equal_(derive_(s,parts[0]),parts[1]);}
function limit_(key,count,seconds){var c=CacheService.getScriptCache(),k='limit:'+hash_(key+':'+Math.floor(now_()/(seconds*1000))),n=Number(c.get(k)||0)+1;require_(n<=count,'Muitas solicitações. Aguarde alguns minutos.');c.put(k,String(n),Math.min(21600,seconds*2));}
function settings_(){var s={};rows_('CourseSettings').forEach(function(x){s[x.key]=typeof x.value==='boolean'?String(x.value):x.value;});return s;}
function lessons_(){var durations=json_(settings_().youtubeDurations,'');return LESSONS.map(function(l){return Object.assign({},l,{duration:durations&&durations[l.id]||l.duration});});}
function setting_(k,v){var x=rows_('CourseSettings').find(function(x){return x.key===k;})||{key:k};x.value=String(v);save_('CourseSettings',x);}
function audit_(who,action,target,details){save_('Audit',{id:id_(),actor:who.email||who.id,action:action,target:target||'',at:now_(),detail_json:JSON.stringify(details||{})});}
function json_(s,fallback){try{return JSON.parse(s||'');}catch(e){return fallback;}}
function privateFile_(name){var f=DriveApp.getFolderById(props_().getProperty('COURSE_FOLDER_ID')),folders=f.getFoldersByName('03 - Preparação da migração');require_(folders.hasNext(),'Pasta de preparação não encontrada.');var files=folders.next().getFilesByName(name);require_(files.hasNext(),'Arquivo privado não encontrado: '+name);var file=files.next();require_(!files.hasNext(),'Há arquivos duplicados: '+name);return file;}
function bank_(){var file=DriveApp.getFileById(props_().getProperty('BANK_FILE_ID'));var b=JSON.parse(file.getBlob().getDataAsString('UTF-8'));validateBank_(b);return b;}
